{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parking Manager",
  "version": "0.1.0",
  "identifier": "com.nyt.parking-manager",
  "build": {
    "frontendDist": "../",
    "devUrl": "../index.html",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Parking Manager",
        "width": 680,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
